<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>Crawlspace2MP</AssemblyName>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Game install path for deployment -->
    <GamePath>D:\SteamLibrary\steamapps\common\Crawlspace 2</GamePath>
  </PropertyGroup>

  <!-- Exclude folders that shouldn't be compiled -->
  <ItemGroup>
    <Compile Remove="Assembly-CSharp\**" />
    <Compile Remove="Preloader\**" />
    <Compile Remove="crawlspace2decompiledunityproject\**" />
    <EmbeddedResource Remove="Preloader\**" />
    <EmbeddedResource Remove="crawlspace2decompiledunityproject\**" />
    <None Remove="Preloader\**" />
    <None Remove="crawlspace2decompiledunityproject\**" />
  </ItemGroup>

  <!-- Debug configuration -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <Optimize>false</Optimize>
    <DebugType>full</DebugType>
  </PropertyGroup>

  <!-- Release configuration - minimal logging -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DefineConstants>RELEASE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- Copy to Thunderstore package folder -->
  <Target Name="CopyToThunderstore" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll"
          DestinationFolder="Thunderstore\BepInEx\plugins\Crawlspace2MP\"
          SkipUnchangedFiles="false" />
    <Copy SourceFiles="mpassets"
          DestinationFolder="Thunderstore\BepInEx\plugins\Crawlspace2MP\"
          SkipUnchangedFiles="true" />
    <Message Text="Copied mod DLL to Thunderstore folder" Importance="high" />
  </Target>

  <!-- Copy steam_api64.dll to game folder on build -->
  <Target Name="CopySteamApi" AfterTargets="Build">
    <Copy SourceFiles="$(NuGetPackageRoot)facepunch.steamworks\2.3.3\content\steam_api64.dll"
          DestinationFolder="$(GamePath)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(GamePath)')" />
    <!-- Create steam_appid.txt if it doesn't exist -->
    <WriteLinesToFile File="$(GamePath)\steam_appid.txt"
                      Lines="2258670"
                      Overwrite="true"
                      Condition="Exists('$(GamePath)') And !Exists('$(GamePath)\steam_appid.txt')" />
    <!-- Copy mod DLL to plugins folder -->
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll"
          DestinationFolder="$(GamePath)\BepInEx\plugins\Crawlspace2MP"
          SkipUnchangedFiles="false"
          Condition="Exists('$(GamePath)\BepInEx\plugins')" />
    <!-- Copy Facepunch.Steamworks to plugins folder -->
    <Copy SourceFiles="$(OutputPath)Facepunch.Steamworks.Win64.dll"
          DestinationFolder="$(GamePath)\BepInEx\plugins\Crawlspace2MP"
          SkipUnchangedFiles="true"
          Condition="Exists('$(GamePath)\BepInEx\plugins')" />
    <!-- Copy mpassets to plugins folder -->
    <Copy SourceFiles="mpassets"
          DestinationFolder="$(GamePath)\BepInEx\plugins\Crawlspace2MP"
          SkipUnchangedFiles="true"
          Condition="Exists('$(GamePath)\BepInEx\plugins')" />
    <Message Text="Deployed mod to game folder" Importance="high" 
             Condition="Exists('$(GamePath)')" />
  </Target>

  <ItemGroup>
    <!-- BepInEx references - copy these from your BepInEx/core folder -->
    <Reference Include="BepInEx">
      <HintPath>lib\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>lib\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    
    <!-- Unity references - copy from Crawlspace 2_Data/Managed -->
    <Reference Include="UnityEngine">
      <HintPath>lib\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>lib\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>lib\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>lib\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>lib\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.XRModule">
      <HintPath>lib\UnityEngine.XRModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    
    <!-- Game assembly - copy from Crawlspace 2_Data/Managed -->
    <Reference Include="Assembly-CSharp">
      <HintPath>lib\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    
    <!-- New Input System -->
    <Reference Include="Unity.InputSystem">
      <HintPath>lib\Unity.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    
    <!-- XR Management for flatscreen mode -->
    <Reference Include="Unity.XR.Management">
      <HintPath>lib\Unity.XR.Management.dll</HintPath>
      <Private>false</Private>
    </Reference>
    
    <!-- Video module for TV sync -->
    <Reference Include="UnityEngine.VideoModule">
      <HintPath>lib\UnityEngine.VideoModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    
    <!-- Image conversion for spectate JPEG encoding -->
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>lib\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    
    <!-- AI module for NavMeshAgent -->
    <Reference Include="UnityEngine.AIModule">
      <HintPath>lib\UnityEngine.AIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    
    <!-- Audio module -->
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>lib\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    
    <!-- Animation module for Animator -->
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>lib\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    
    <!-- UI module for Image component -->
    <Reference Include="UnityEngine.UI">
      <HintPath>lib\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    
    <!-- UI Module for Canvas -->
    <Reference Include="UnityEngine.UIModule">
      <HintPath>lib\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    
    <!-- Text Rendering for TextAnchor/FontStyle -->
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>lib\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    
    <!-- AssetBundle module for custom models -->
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>lib\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    
    <!-- XR Interaction Toolkit for VR input -->
    <Reference Include="Unity.XR.Interaction.Toolkit">
      <HintPath>lib\Unity.XR.Interaction.Toolkit.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Facepunch.Steamworks for Steam networking -->
    <PackageReference Include="Facepunch.Steamworks" Version="2.3.3" />
  </ItemGroup>

</Project>
